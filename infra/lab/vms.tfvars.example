# Copy to vms.tfvars in your wsl-vmware-lab checkout (gitignored).
# Provisions the three Ubuntu 24.04 x86_64 VMs for Saltation (8 vCPU / 10 GB RAM).
# saltation-oracle (Oracle Linux 8.10, 4 vCPU / 8 GB RAM) is built separately
# with infra/lab/ol8/build-oracle-vm.sh (official OL8 KVM + mods.iso).

vms = {
  "saltation-mongo" = {
    processors = 2
    memory_mb  = 4096
    groups     = ["db", "mongo"]
    image      = "ubuntu-24.04"
    lan        = true
  }
  "saltation-bank" = {
    processors = 4
    memory_mb  = 4096
    groups     = ["app", "bank", "web"]
    image      = "ubuntu-24.04"
    lan        = true
  }
  "saltation-gen" = {
    processors = 2
    memory_mb  = 2048
    groups     = ["gen", "generator"]
    image      = "ubuntu-24.04"
    lan        = true
  }
}
