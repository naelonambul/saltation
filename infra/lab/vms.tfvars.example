# Copy to vms.tfvars in your wsl-vmware-lab checkout (gitignored).
# Provisions all five Saltation x86_64 VMs (14 vCPU / 20 GB RAM total),
# matching the Docker Compose service separation 1:1.
# Requires wsl-vmware-lab with oraclelinux-8 support (PR #61+).

vms = {
  "saltation-oracle" = {
    processors = 4
    memory_mb  = 8192
    groups     = ["db", "oracle"]
    image      = "oraclelinux-8"
    lan        = true
  }
  "saltation-mongo" = {
    processors = 2
    memory_mb  = 4096
    groups     = ["db", "mongo"]
    image      = "ubuntu-24.04"
    lan        = true
  }
  "saltation-bank" = {
    processors = 4
    memory_mb  = 4096
    groups     = ["app", "bank"]
    image      = "ubuntu-24.04"
    lan        = true
  }
  "saltation-web" = {
    processors = 2
    memory_mb  = 2048
    groups     = ["web"]
    image      = "ubuntu-24.04"
    lan        = true
  }
  "saltation-gen" = {
    processors = 2
    memory_mb  = 2048
    groups     = ["gen", "generator"]
    image      = "ubuntu-24.04"
    lan        = true
  }
}
