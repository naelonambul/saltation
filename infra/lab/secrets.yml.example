# Copy outside git (for example ~/.config/saltation-lab/secrets.yml, chmod 600)
# and replace every value before running Ansible playbooks.
# oracle_db_password should start with a letter and mix case + digits.
mongo_root_password: REPLACE_WITH_RANDOM_HEX
mongo_bank_password: REPLACE_WITH_RANDOM_HEX
mongo_generator_password: REPLACE_WITH_RANDOM_HEX
oracle_db_password: Salt_REPLACE_WITH_RANDOM_HEX
