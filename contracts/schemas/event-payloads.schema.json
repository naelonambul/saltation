{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saltation business event payloads",
  "description": "Select the definition with the same name as the event_type in the log envelope.",
  "$defs": {
    "request.completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http_status",
        "endpoint",
        "method",
        "duration_ms"
      ],
      "properties": {
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 999
        },
        "endpoint": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "request_type": {
          "type": "string"
        },
        "replayed": {
          "type": "boolean"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "tran_amt": {
          "type": "integer"
        },
        "transfer_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        },
        "counterparty_bank_code": {
          "type": "string"
        },
        "counterparty_account_no": {
          "type": "string"
        }
      }
    },
    "login.succeeded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "failed_count"
      ],
      "properties": {
        "outcome": {
          "const": "SUCCESS"
        },
        "failed_count": {
          "type": "integer"
        }
      }
    },
    "login.failed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "failed_count"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "UNKNOWN_PHONE",
            "WRONG_PASSWORD",
            "LOCKED"
          ]
        },
        "failed_count": {
          "type": "integer"
        }
      }
    },
    "analyst.login.succeeded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyst_id"
      ],
      "properties": {
        "analyst_id": {
          "type": "string"
        }
      }
    },
    "analyst.login.failed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyst_id"
      ],
      "properties": {
        "analyst_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "logout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "device.new": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "password_reset.requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "enum": [
            "issued",
            "unknown"
          ]
        }
      }
    },
    "password_reset.completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "const": "completed"
        }
      }
    },
    "password_reset.failed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "enum": [
            "unknown",
            "missing",
            "superseded",
            "used",
            "expired",
            "voided",
            "incorrect"
          ]
        }
      }
    },
    "payee.registered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payee_id",
        "bank_code_std",
        "account_num"
      ],
      "properties": {
        "payee_id": {
          "type": "string"
        },
        "bank_code_std": {
          "type": "string"
        },
        "account_num": {
          "type": "string"
        }
      }
    },
    "payee.deleted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payee_id",
        "bank_code_std",
        "account_num"
      ],
      "properties": {
        "payee_id": {
          "type": "string"
        },
        "bank_code_std": {
          "type": "string"
        },
        "account_num": {
          "type": "string"
        }
      }
    },
    "account.status_changed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "reason"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "rollover.job_completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_date",
        "job"
      ],
      "properties": {
        "business_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "job": {
          "enum": [
            "maturity",
            "dormancy",
            "daily_close",
            "atm_session_expiry"
          ]
        }
      }
    },
    "atm.session_started": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_id",
        "region",
        "latitude",
        "longitude",
        "account_no",
        "request_id",
        "session_id"
      ],
      "properties": {
        "terminal_id": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "latitude": {
          "type": "string"
        },
        "longitude": {
          "type": "string"
        },
        "account_no": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        }
      }
    },
    "atm.session_rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_id",
        "region",
        "latitude",
        "longitude",
        "account_no",
        "request_id",
        "bank_rsp_code",
        "locked"
      ],
      "properties": {
        "terminal_id": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "latitude": {
          "type": "string"
        },
        "longitude": {
          "type": "string"
        },
        "account_no": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "bank_rsp_code": {
          "type": "string"
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "atm.session_ended": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_id",
        "region",
        "latitude",
        "longitude",
        "account_no",
        "request_id",
        "reason",
        "session_id",
        "start_request_id",
        "ended_at"
      ],
      "properties": {
        "terminal_id": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "latitude": {
          "type": "string"
        },
        "longitude": {
          "type": "string"
        },
        "account_no": {
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "enum": [
            "expired",
            "replaced",
            "ended",
            "locked"
          ]
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "start_request_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "atm.operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_id",
        "region",
        "latitude",
        "longitude",
        "account_no",
        "request_id",
        "operation",
        "outcome",
        "amount",
        "rsp_code",
        "bank_rsp_code"
      ],
      "properties": {
        "terminal_id": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "latitude": {
          "type": "string"
        },
        "longitude": {
          "type": "string"
        },
        "account_no": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "operation": {
          "enum": [
            "withdraw",
            "deposit",
            "balance"
          ]
        },
        "outcome": {
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "amount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "rsp_code": {
          "type": "string"
        },
        "bank_rsp_code": {
          "type": "string"
        }
      }
    },
    "card.authorized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_id",
        "idempotency_key",
        "card_no",
        "krw_amount",
        "amount",
        "currency",
        "merchant_name",
        "mcc",
        "country",
        "entry_mode",
        "latitude",
        "longitude",
        "decline_reason"
      ],
      "properties": {
        "client_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "card_no": {
          "type": "string"
        },
        "krw_amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999999999
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "currency": {
          "enum": [
            "KRW",
            "USD",
            "EUR",
            "JPY",
            "CNY"
          ]
        },
        "merchant_name": {
          "type": "string"
        },
        "mcc": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "entry_mode": {
          "enum": [
            "online",
            "in_person"
          ]
        },
        "latitude": {
          "type": [
            "string",
            "null"
          ]
        },
        "longitude": {
          "type": [
            "string",
            "null"
          ]
        },
        "decline_reason": {
          "const": null
        }
      },
      "oneOf": [
        {
          "properties": {
            "entry_mode": {
              "const": "online"
            },
            "latitude": {
              "const": null
            },
            "longitude": {
              "const": null
            }
          }
        },
        {
          "properties": {
            "entry_mode": {
              "const": "in_person"
            },
            "latitude": {
              "type": "string"
            },
            "longitude": {
              "type": "string"
            }
          }
        }
      ]
    },
    "card.declined": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_id",
        "idempotency_key",
        "card_no",
        "krw_amount",
        "amount",
        "currency",
        "merchant_name",
        "mcc",
        "country",
        "entry_mode",
        "latitude",
        "longitude",
        "decline_reason"
      ],
      "properties": {
        "client_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "card_no": {
          "type": "string"
        },
        "krw_amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999999999
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "currency": {
          "enum": [
            "KRW",
            "USD",
            "EUR",
            "JPY",
            "CNY"
          ]
        },
        "merchant_name": {
          "type": "string"
        },
        "mcc": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "entry_mode": {
          "enum": [
            "online",
            "in_person"
          ]
        },
        "latitude": {
          "type": [
            "string",
            "null"
          ]
        },
        "longitude": {
          "type": [
            "string",
            "null"
          ]
        },
        "decline_reason": {
          "enum": [
            "unknown_card",
            "blocked_card",
            "closed_account",
            "insufficient_balance"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "entry_mode": {
              "const": "online"
            },
            "latitude": {
              "const": null
            },
            "longitude": {
              "const": null
            }
          }
        },
        {
          "properties": {
            "entry_mode": {
              "const": "in_person"
            },
            "latitude": {
              "type": "string"
            },
            "longitude": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
